{
  "name": "dsh-deepseek-billing-period",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Shows the current DeepSeek API billing period (peak / off-peak) below the composer.",
  "meta": {
    "title": "DeepSeek 计费时段",
    "description": "在输入框下方显示当前 DeepSeek API 计费时段（高峰/空闲）与下一时段倒计时，按北京时间与中国法定节假日判断。"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
